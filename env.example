# Copy to <project>/.jira/.env (the `init` command does this) and fill in. Two auth options — chosen per service.
#
# ── Option A: Server / Data Center (self-hosted, e.g. https://jira.example.com) ───────────────────────────────
#   A Personal Access Token from the Jira profile and a separate one from the Confluence profile. Sent as Authorization: Bearer.
#   Do NOT set an email (no email = bearer auth).
#
# ── Option B: Atlassian Cloud (https://<site>.atlassian.net) ──────────────────────────────────────────────────
#   One API token (id.atlassian.com → Security → API tokens) works for both Jira and Confluence.
#   Sent as Authorization: Basic base64(email:token) — so the account email is required.
#   URLs are used exactly as given: Jira — https://<site>.atlassian.net, Confluence — https://<site>.atlassian.net/wiki.

# Jira: base URL without a trailing slash (Cloud: https://<site>.atlassian.net)
JIRA_BASE_URL=https://example.atlassian.net
# Main project for probe (permissions, issue count), e.g. PROJ; if empty — the first visible project
JIRA_PROJECT=
# A: Jira PAT. B: may stay empty if ATLASSIAN_API_TOKEN is set below.
JIRA_TOKEN=

# Confluence (optional): base URL without a trailing slash, as is (Cloud: https://<site>.atlassian.net/wiki)
CONFLUENCE_BASE_URL=https://example.atlassian.net/wiki
# A: separate Confluence PAT. B: may stay empty.
CONFLUENCE_TOKEN=

# B (Cloud): shared API token and email — used when JIRA_TOKEN / CONFLUENCE_TOKEN are empty
ATLASSIAN_API_TOKEN=
ATLASSIAN_EMAIL=

# Optional: force the auth mode if auto-detection does not fit (bearer | basic).
# The email can also be set per service: JIRA_EMAIL / CONFLUENCE_EMAIL.
# JIRA_AUTH=
# CONFLUENCE_AUTH=
# ATLASSIAN_CLOUD=1   # Cloud on a custom domain (not *.atlassian.net)

# 1 — skip TLS certificate verification (self-hosted only, when the corporate root CA is missing from the OS store)
JIRA_INSECURE_TLS=

# Optional: another folder for results (default <project>/.jira/out)
# JIRA_OUT_DIR=
